PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=123456
POSTGRES_DB=knowledge_hub

# MongoDB
MONGO_URI=mongodb://mongo_user:mongo_pass123@localhost:27017/knowledge_hub?authSource=admin

# Snowflake (snowflake-id: mid 0–1023)
SNOWFLAKE_WORKER_ID=1
# Epoch offset ms; default ≈ 2024-01-01
SNOWFLAKE_OFFSET=1704067200000

# RustFS（S3 兼容）。本地可用 docker-compose 的 rustfs 服务
RUSTFS_ENABLED=true
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_PUBLIC_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=knowledge-hub
RUSTFS_REGION=us-east-1

# RabbitMQ（文档发布后异步 RAG / KG / ES）
RABBITMQ_ENABLED=true
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# RAG 分块
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64

# Embedding（OpenAI 兼容；不配 Key 则用本地哈希向量降级）
EMBEDDING_DIMENSION=1024
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BATCH_SIZE=10
# EMBEDDING_API_KEY=
# DASHSCOPE_API_KEY=

# RAG 混合检索（/rag/search、/ai/chat：关键词 + 向量 → RRF → rerank）
RAG_HYBRID_TOP_K=20
RAG_RRF_C=60
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
# rerank 相关度低于此值的块丢掉（0–1）。0 表示不过滤。RRF 降级时不生效。
RAG_MIN_SCORE=0.4
# RERANK_API_KEY=
# RERANK_BASE_URL=https://dashscope.aliyuncs.com
# AI_CHAT_TIMEOUT_MS=60000

# LLM 抽取（KG）—— OpenAI 兼容接口（必填，不配则抽取报错）
# qwen-plus + 完整抽取 prompt 常超过 20s；超时后不再重试
KG_LLM_TIMEOUT_MS=120000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-plus
# 问答流式开启模型思考（qwen-plus 兼容接口 extra enable_thinking）
# LLM_ENABLE_THINKING=true

# 联网搜索（Bocha，与 cron-job-tool 相同；不配则 tool 返回提示）
# BOCHA_API_KEY=

# Elasticsearch（文档搜索；不可用时跳过写入）
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_NODE=http://localhost:9200

# Neo4j（KG 图谱；不可用时跳过写入）
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=12345678

# JWT 鉴权（用户模块）
JWT_SECRET=dev-secret-change-me-in-production
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# 邮箱验证（默认 false：注册后立即可登录；true 时需邮件激活）
REQUIRE_EMAIL_VERIFICATION=false
APP_PUBLIC_URL=http://localhost:3000

# SMTP 邮件（@nestjs-modules/mailer + nodemailer）
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=xx@xx.com
MAIL_PASS=xx
MAIL_FROM="Knowledge Hub <xx@xx.com>"


# Redis（密码重置验证码、对话短期记忆热窗口）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 对话短期记忆：Redis 热窗口，miss 时从 Postgres 回填。TTL 到期不丢历史，只是下次从库加载。
CHAT_SHORT_MEMORY_TTL_SECONDS=86400
CHAT_SHORT_MEMORY_MAX_MESSAGES=20
# CHAT_SHORT_MEMORY_KEY_PREFIX=kh:chat

# 检索改写：追问消解指代后再搜。超时或失败回退原问题。
# AI_QUERY_REWRITE_TIMEOUT_MS=15000

# 对话长期记忆（Mem0）。不配则跳过，不影响问答。记忆不是知识库，制度仍以检索为准。
# MEM0_API_KEY=
# MEM0_HOST=https://api.mem0.ai
MEM0_TOP_K=5

# LangSmith（LangChain Agent / 对话链路追踪）。不配 Key 则不上报。
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=knowledge-hub

# 文档发布审核（true 默认：发布走 PendingReview）
DOCUMENT_REQUIRE_APPROVAL=true
